# --- Server ---
# Port the FastAPI app listens on
PORT=8000

# --- Database ---
# SQLite file path (relative to project root). Survives restarts on disk.
DATABASE_URL=sqlite:///./patients.db

# --- Vapi ---
# Shared secret Vapi sends in the `x-vapi-secret` header on tool-call webhooks.
# Set this in your Vapi assistant's tool/server config so we can verify requests
# actually came from Vapi (basic auth, not full HMAC verification).
VAPI_WEBHOOK_SECRET=change-me

# Not required by the backend itself, but documented here because the voice
# agent is configured in the Vapi dashboard using these:
# VAPI_API_KEY=your-vapi-private-api-key
# OPENAI_API_KEY=your-openai-key   (if using OpenAI as the Vapi model provider)
